# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Base URL of the upstream BMKG feed bucket (no trailing slash). SECRET — never commit or expose it.
BMKG_API=

# Public origin used for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://gempa.rone.dev

# FastAPI debug mode (tracebacks in responses). Keep false in production.
DEBUG=false
